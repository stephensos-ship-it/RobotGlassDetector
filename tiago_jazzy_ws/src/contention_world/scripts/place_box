#!/usr/bin/env python3
"""Move a hallway's box into the robot's path, or park it back out of sight.

  ros2 run contention_world place_box 6.0              hallway 1's box at x = 6 m, centred
  ros2 run contention_world place_box 6.0 --hallway 2  the same in hallway 2 (tiago2's)
  ros2 run contention_world place_box 6.0 --y 0.3      0.3 m left of hallway 1's centreline
  ros2 run contention_world place_box --hide           park hallway 1's box out of sight again
"""

import argparse
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET

from ament_index_python.packages import get_package_share_directory

# Each hallway's centreline, as laid out in worlds/hallway.sdf.
CENTRELINE_Y = {1: 0.0, 2: 2.2}


def parked_pose(box):
    """Read the box's starting pose from the world file, its one home."""
    path = Path(get_package_share_directory('contention_world')) / 'worlds' / 'hallway.sdf'
    for model in ET.parse(path).getroot().iter('model'):
        if model.get('name') == box:
            return [float(value) for value in (model.findtext('pose') or '').split()]
    raise RuntimeError(f'{path} has no {box} model')


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument('x', type=float, nargs='?', help='box centre along the hallway (m)')
    parser.add_argument('--y', type=float, default=0.0,
                        help='box centre across the hallway, from its centreline (m)')
    parser.add_argument('--hallway', type=int, default=1, choices=sorted(CENTRELINE_Y),
                        help='which hallway: 1 (tiago1, the default) or 2 (tiago2)')
    parser.add_argument('--hide', action='store_true', help='park the box behind the wall')
    args = parser.parse_args()
    if args.hide == (args.x is not None):
        parser.error('give a position along the hallway, or --hide')
    box = f'box{args.hallway}'
    parked = parked_pose(box)
    x, y = parked[:2] if args.hide else (args.x, CENTRELINE_Y[args.hallway] + args.y)
    request = f'name: "{box}", position: {{x: {x}, y: {y}, z: {parked[2]}}}, orientation: {{w: 1}}'
    try:
        result = subprocess.run(
            ['gz', 'service', '-s', '/world/hallway/set_pose', '--reqtype', 'gz.msgs.Pose',
             '--reptype', 'gz.msgs.Boolean', '--timeout', '3000', '--req', request],
            capture_output=True, text=True, check=False,
        )
    except FileNotFoundError:
        sys.exit('The gz command is missing; source the ROS 2 Jazzy setup first.')
    if result.returncode or 'data: true' not in result.stdout:
        reply = (result.stdout + result.stderr).strip() or 'no reply; is the hallway running?'
        sys.exit(f'Gazebo did not move {box}: {reply}')
    print(f'{box} at x={x:g} m, y={y:g} m')


if __name__ == '__main__':
    main()
