<?xml version="1.0" ?>
<!--
  Two straight hallways side by side for the stopping-distance trials. Each is 12 m long
  along +x, 2 m clear width, with 2 m tall walls, and open at both ends so nothing but
  its box is ever in a robot's path. They share the middle wall:

    hallway 1: centreline y = 0.0, between wall_right and wall_middle
    hallway 2: centreline y = 2.2, between wall_middle and wall_left

  The one-robot launch (launch/hallway.launch.py) spawns TIAGo in hallway 1 and ignores
  hallway 2. The two-robot launch (launch/two_tiagos.launch.py) puts tiago1 in hallway 1
  and tiago2 in hallway 2. Both start at x = 1 facing +x.

  Each hallway has a 0.4 m box (box1, box2) waiting behind its outer wall, out of sight
  of the lidar and the head camera, until something moves it into the hallway through
  Gazebo's /world/hallway/set_pose service (scripts/place_box). The boxes are static, so
  they neither settle after a move nor get pushed by a robot.

  Load it through tiago_gazebo / pal_gazebo_worlds: that loader adds the physics,
  sensor, user-command and contact systems.
-->
<sdf version="1.9">
  <world name="hallway">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls are 0.2 m thick with centres 2.2 m apart, so each hallway's inner faces
         are 1.0 m either side of its centreline. -->
    <model name="wall_right">
      <static>true</static>
      <pose>6 -1.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_middle">
      <static>true</static>
      <pose>6 1.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>6 3.3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The obstacles. place_box's hide option returns each to its parked pose here. -->
    <model name="box1">
      <static>true</static>
      <pose>6 -3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box2">
      <static>true</static>
      <pose>6 5.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
