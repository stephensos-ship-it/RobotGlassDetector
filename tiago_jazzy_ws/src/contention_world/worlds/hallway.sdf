<?xml version="1.0" ?>
<!--
  Straight hallway for the stopping-distance trials: 12 m long along +x, 2 m clear
  width, 2 m tall walls, open at both ends so nothing but the box is ever in TIAGo's
  path. TIAGo spawns at x = 1 facing +x (launch/hallway.launch.py).

  The 0.4 m box waits behind the right wall, out of sight of the lidar and the head
  camera, until something moves it into the hallway through Gazebo's
  /world/hallway/set_pose service (scripts/place_box). It is static, so it neither
  settles after a move nor gets pushed by the robot.

  Load it through tiago_gazebo / pal_gazebo_worlds: that loader adds the physics,
  sensor, user-command and contact systems.
-->
<sdf version="1.9">
  <world name="hallway">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall centres sit 1.1 m either side of the centreline; 0.2 m thick, so the
         inner faces are at y = +/-1.0 m. -->
    <model name="left_wall">
      <static>true</static>
      <pose>6 1.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_wall">
      <static>true</static>
      <pose>6 -1.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The obstacle. place_box's hide option returns it to this parked pose. -->
    <model name="box">
      <static>true</static>
      <pose>6 -3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
