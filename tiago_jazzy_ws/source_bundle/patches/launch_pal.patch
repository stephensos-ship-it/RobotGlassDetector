+
+"""Prepare physics descriptions while preserving the public ROS robot model."""
+
+import xml.etree.ElementTree as ET
+
+
+def harmonic_spawn_description(description):
+    """Avoid duplicate mimic constraints and DART zero-stop motor locking."""
+    root = ET.fromstring(description)
+    for joint in root.findall('joint'):
+        # gz_ros2_control implements mimic joints; DART must not duplicate them.
+        for mimic in joint.findall('mimic'):
+            joint.remove(mimic)
+        # Keep controller/MoveIt limits unchanged. Only the physics description
+        # receives clearance so a motor can move away from a zero hard stop.
+        limit = joint.find('limit')
+        if limit is not None:
+            if float(limit.get('lower', '-1')) == 0.0:
+                limit.set('lower', '-0.0001')
+            if float(limit.get('upper', '1')) == 0.0:
+                limit.set('upper', '0.0001')
+    return ET.tostring(root, encoding='unicode')
