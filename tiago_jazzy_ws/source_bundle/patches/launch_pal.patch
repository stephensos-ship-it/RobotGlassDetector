+from launch.actions import ResetLaunchConfigurations
+from launch.launch_context import LaunchContext
+from launch.substitutions import LaunchConfiguration
+from launch_pal.include_utils import get_nested_launch_configurations
+from launch_pal.include_utils import isolate_ros_remaps
+
+
+def test_renamed_launch_configuration_preserves_explicit_false():
+    context = LaunchContext()
+    context.launch_configurations['moveit'] = 'False'
+    configurations = get_nested_launch_configurations(
+        {'play_motion': LaunchConfiguration('moveit')}
+    )
+    ResetLaunchConfigurations(configurations).execute(context)
+    assert context.launch_configurations == {'moveit': 'False', 'play_motion': 'False'}
+
+
+def test_child_remaps_do_not_mutate_parent_scope():
+    context = LaunchContext()
+    parent = [('/tf', 'tf')]
+    context.launch_configurations['ros_remaps'] = parent
+    context._push_launch_configurations()
+    isolate_ros_remaps(context)
+    context.launch_configurations['ros_remaps'].append(('/map', 'map'))
+    context._pop_launch_configurations()
+    assert context.launch_configurations['ros_remaps'] == [('/tf', 'tf')]
+    assert parent == [('/tf', 'tf')]
