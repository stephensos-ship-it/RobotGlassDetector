+    world = tree.getroot().find('world')
+    if world is None:
+        raise ValueError(f'SDF has no world: {candidate}')
+    # Classic's world state and collision services are replaced by Harmonic's
+    # UserCommands and Contact systems. Never load Classic shared libraries.
+    replaced = {'libgazebo_ros_state.so', 'libpal_gazebo_collisions.so'}
+    for parent in tree.iter():
+        for plugin in list(parent.findall('plugin')):
+            library = plugin.get('filename', '')
+            if library in replaced:
+                parent.remove(plugin)
+            elif library.startswith(('libgazebo_', 'libpal_gazebo_', 'librandom_actor')):
+                raise ValueError(
+                    f'{candidate.name} contains an embedded Classic-only system: {library}'
+                )
+    # Resolve Classic's two standard world includes locally, without Fuel or
+    # a Gazebo Classic model database dependency.
+    template = ET.fromstring(
+        re.sub(r'<!--.*?-->', '', (share / 'worlds/empty.sdf').read_text(), flags=re.DOTALL)
+    )
+    for parent in tree.iter():
+        for include in list(parent.findall('include')):
+            uri = include.findtext('uri', '')
+            replacement = None
+            if uri == 'model://sun':
+                replacement = template.find('.//light')
+            elif uri == 'model://ground_plane':
+                replacement = template.find('.//model')
+            if replacement is not None:
+                replacement = copy.deepcopy(replacement)
+                for tag in ['pose', 'name']:
+                    value = include.findtext(tag)
+                    if value is not None:
+                        if tag == 'name':
