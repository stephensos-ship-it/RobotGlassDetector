+def start_gazebo(context):
+    share = Path(get_package_share_directory('pal_gazebo_worlds'))
+    name = LaunchConfiguration('world_name').perform(context)
+    aliases = {'empty_world': 'empty'}
+    candidate = Path(name)
+    if not candidate.is_file():
+        candidate = share / 'worlds' / (aliases.get(name, name) + '.sdf')
+    if not candidate.is_file():
+        candidate = share / 'worlds' / (aliases.get(name, name) + '.world')
+    if not candidate.is_file():
+        extra = Path(get_package_share_directory('br2_gazebo_worlds'))
+        candidate = extra / 'worlds' / (name + '.world')
+    if not candidate.is_file():
