+    def namespace_topics(value):
+        if isinstance(value, dict):
+            for key, item in value.items():
+                if isinstance(item, str) and item.startswith('/') and key.endswith('topic'):
+                    value[key] = prefix + item
+                else:
+                    namespace_topics(item)
+
+    namespace_topics(configuration)
+    configuration['bt_navigator']['ros__parameters']['odom_topic'] = (
