+def stop_navigation(context, namespace, ros_context, node, executor, clients):
+    """Deactivate and clean up Nav2 while its executors and sensor TF are live."""
+    from nav2_msgs.srv import ManageLifecycleNodes
+    try:
+        for manager, client in clients.items():
+            if not client.wait_for_service(timeout_sec=3.0):
+                node.destroy_client(client)
+                if manager == 'navigation':
+                    raise RuntimeError('Nav2 navigation shutdown service is unavailable')
+                continue
+            request = ManageLifecycleNodes.Request()
+            request.command = ManageLifecycleNodes.Request.SHUTDOWN
+            future = client.call_async(request)
+            executor.spin_until_future_complete(future, timeout_sec=15.0)
+            if future.result() is not None and future.result().success:
+                print(f'Nav2 {manager} shutdown complete for {namespace or "/"}', flush=True)
+            else:
+                raise RuntimeError(f'Nav2 {manager} shutdown failed for {namespace or "/"}')
+            node.destroy_client(client)
+    finally:
+        executor.remove_node(node)
+        executor.shutdown()
+        node.destroy_node()
+        ros_context.shutdown()
+
+
+def register_orderly_shutdown(context, namespace, mapping):
+    """Keep lifecycle cleanup ahead of launch's process signal handlers."""
+    import rclpy
+    from nav2_msgs.srv import ManageLifecycleNodes
+    from rclpy.context import Context
+    from rclpy.executors import SingleThreadedExecutor
+    from rclpy.signals import SignalHandlerOptions
+
+    # Create the clients at startup so request AND reply discovery has settled
+    # before shutdown. Creating fresh clients during teardown races Fast DDS
+    # service discovery (ros2/rmw_fastrtps#842).
+    ros_context = Context()
+    rclpy.init(args=[], context=ros_context, signal_handler_options=SignalHandlerOptions.NO)
+    node = rclpy.create_node(
+        'tiago_navigation_shutdown', namespace=namespace or '/', context=ros_context
     )
