index 0000000000000000000000000000000000000000..1dafbf007a15085e5478080270965077bbc715d6
--- /dev/null
+++ b/tiago_multi/launch/multitiago_gazebo.launch.py
@@ -0,0 +1,67 @@
+# Copyright 2026 TIAGo Jazzy port contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Spawn two independent namespaced TIAGos in one Harmonic server."""
+
+from pathlib import Path
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument
+from launch.actions import IncludeLaunchDescription
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.substitutions import LaunchConfiguration
+
+
+def generate_launch_description():
+    simulation = str(
+        Path(get_package_share_directory('tiago_gazebo')) / 'launch' / 'tiago_gazebo.launch.py'
+    )
+    worlds = str(
+        Path(get_package_share_directory('pal_gazebo_worlds')) / 'launch' / 'pal_gazebo.launch.py'
+    )
+    actions = [
+        DeclareLaunchArgument('world_name', default_value='pal_office'),
+        DeclareLaunchArgument('gzclient', default_value='True'),
+        DeclareLaunchArgument('moveit', default_value='False'),
+        DeclareLaunchArgument('navigation', default_value='False'),
+        DeclareLaunchArgument('slam', default_value='False'),
+        IncludeLaunchDescription(
+            PythonLaunchDescriptionSource(worlds),
+            launch_arguments={
+                'world_name': LaunchConfiguration('world_name'),
+                'gzclient': LaunchConfiguration('gzclient'),
+            }.items(),
+        ),
+    ]
+    for index, y in [(1, '-1.0'), (2, '1.0')]:
+        namespace = f'tiago{index}'
+        actions.append(
+            IncludeLaunchDescription(
+                PythonLaunchDescriptionSource(simulation),
+                launch_arguments={
+                    'robot_name': namespace,
+                    'publish_clock': str(index == 1),
+                    'namespace': namespace,
+                    'launch_world': 'False',
+                    'is_public_sim': 'True',
+                    'world_name': LaunchConfiguration('world_name'),
+                    'moveit': LaunchConfiguration('moveit'),
+                    'navigation': LaunchConfiguration('navigation'),
+                    'slam': LaunchConfiguration('slam'),
+                    'tuck_arm': 'False',
+                    'y': y,
+                    'rviz': 'False',
+                }.items(),
+            )
+        )
+    return LaunchDescription(actions)
