+def spawn(context):
+    def value(name):
+        return LaunchConfiguration(name).perform(context)
+
+    namespace = value('namespace').strip('/')
+    prefix = '/' + namespace if namespace else ''
+    base = value('base_type')
+    camera = value('camera_model') != 'no-camera'
+    laser = value('laser_model') != 'no-laser'
+    share = Path(get_package_share_directory('tiago_bringup'))
+    bridges = yaml.safe_load((share / 'config' / 'bridge' / 'tiago_bridge.yaml').read_text())
+    selected = []
+    for bridge in bridges:
+        name = bridge['ros_topic_name'].strip('/')
+        if name == 'tf':
+            continue
+        if name.startswith('head_front_camera') and not camera:
+            continue
+        if name.startswith('scan') and not laser:
+            continue
+        if base == 'omni_base' and (
+            name.startswith('sonar') or name in ['scan_raw', 'scan_raw/points']
+        ):
+            continue
+        if base == 'pmb2' and name in ['scan_front_raw', 'scan_rear_raw']:
+            continue
+        bridge = dict(bridge)
+        if bridge['ros_type_name'].startswith('sensor_msgs/'):
+            # Live sensor samples must not queue behind reliable retransmits
+            # of multi-megabyte clouds. Keep lidar and TF consumers current.
+            bridge['qos_profile'] = 'SENSOR_DATA'
+        if name == 'sonar_base':
+            # Keep the Classic ROS Range interface; the native sensor's
+            # LaserScan is an internal input to the compatibility adapter.
+            bridge['ros_topic_name'] = 'sonar_base/scan'
+        if name == 'clock':
+            if value('publish_clock').lower() != 'true':
+                continue
+            bridge['ros_topic_name'] = '/clock'
+            bridge['qos_profile'] = 'CLOCK'
+        else:
+            bridge['gz_topic_name'] = prefix + '/' + bridge['gz_topic_name'].strip('/')
+        selected.append(bridge)
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.yaml', delete=False) as stream:
+        yaml.safe_dump(selected, stream)
+        config_path = Path(stream.name)
+    atexit.register(config_path.unlink, missing_ok=True)
+    arguments = ['-name', value('robot_name'), '-topic', prefix + '/robot_description_sim']
+    for flag, name in [
+        ('x', 'x'),
+        ('y', 'y'),
+        ('z', 'z'),
+        ('R', 'roll'),
+        ('P', 'pitch'),
+        ('Y', 'yaw'),
+    ]:
+        arguments.extend(['-' + flag, value(name)])
+    actions = [
+        Node(package='ros_gz_sim', executable='create', output='screen', arguments=arguments),
+        Node(
+            package='ros_gz_bridge',
+            executable='parameter_bridge',
+            name='bridge_ros_gz',
+            output='screen',
+            parameters=[{'config_file': str(config_path), 'use_sim_time': True}],
+        ),
+        Node(
+            package='tiago_gazebo',
+            executable='simulation_adapter.py',
+            output='screen',
+            parameters=[{'use_sim_time': True, 'base_type': base}],
+        ),
+    ]
+    if camera:
+        for suffix in ['image', 'depth_image']:
+            actions.append(
+                Node(
+                    package='ros_gz_image',
+                    executable='image_bridge',
+                    name='bridge_camera_' + suffix,
+                    output='screen',
+                    parameters=[{'use_sim_time': True, 'qos': 'sensor_data'}],
+                    arguments=[prefix + '/head_front_camera/' + suffix],
+                )
+            )
+    return actions
 
 
