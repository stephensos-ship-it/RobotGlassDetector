diff --git a/tiago_gazebo/scripts/simulation_adapter.py b/tiago_gazebo/scripts/simulation_adapter.py
new file mode 100755
index 0000000000000000000000000000000000000000..ebb616496228cd3610db12f06c2d1630f77e4f05
--- /dev/null
+++ b/tiago_gazebo/scripts/simulation_adapter.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+# Copyright 2026 TIAGo Jazzy port contributors
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Preserve TIAGo velocity and sensor interfaces across the Harmonic migration."""
+
+import math
+import signal
+
+from control_msgs.msg import JointTrajectoryControllerState
+from geometry_msgs.msg import Twist
+from geometry_msgs.msg import TwistStamped
+from launch_pal.urdf_utils import harmonic_spawn_description
+import rclpy
+from rclpy.executors import ExternalShutdownException
+from rclpy.node import Node
+from rclpy.qos import DurabilityPolicy
+from rclpy.qos import qos_profile_sensor_data
+from rclpy.qos import QoSProfile
+from rclpy.signals import SignalHandlerOptions
+from sensor_msgs.msg import CameraInfo
+from sensor_msgs.msg import Image
+from sensor_msgs.msg import LaserScan
+from sensor_msgs.msg import PointCloud2
+from sensor_msgs.msg import Range
+from std_msgs.msg import String
+from tf2_ros import Buffer
+from tf2_ros import TransformException
+from tf2_ros import TransformListener
+
+
+class SimulationAdapter(Node):
+    """Stamp velocity inputs, maintain the stop watchdog, and bridge legacy names."""
+
+    def __init__(self):
+        super().__init__('simulation_adapter')
+        self.declare_parameter('base_type', 'pmb2')
+        description_qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
+        self.sim_description = self.create_publisher(
+            String, 'robot_description_sim', description_qos
+        )
+        self.description_input = self.create_subscription(
+            String, 'robot_description', self.prepare_sim_description, description_qos
+        )
+        self.command = Twist()
+        self.command_time = None
+        self.velocity = self.create_publisher(TwistStamped, 'mobile_base_controller/cmd_vel', 10)
+        self.inputs = [
+            self.create_subscription(Twist, topic, self.receive_velocity, 10)
+            for topic in ['cmd_vel_muxed', 'mobile_base_controller/cmd_vel_unstamped']
+        ]
+        self.timer = self.create_timer(0.05, self.publish_velocity)
+        self.relays = []
+        for controller in ['arm', 'torso', 'head', 'gripper', 'hand']:
+            publisher = self.create_publisher(
+                JointTrajectoryControllerState, controller + '_controller/state', 10
+            )
+            self.relays.append(
+                self.create_subscription(
+                    JointTrajectoryControllerState,
+                    controller + '_controller/controller_state',
+                    publisher.publish,
+                    10,
+                )
+            )
+        if self.get_parameter('base_type').value == 'pmb2':
+            self.sonar = self.create_publisher(Range, 'sonar_base', qos_profile_sensor_data)
+            self.relays.append(
+                self.create_subscription(
+                    LaserScan, 'sonar_base/scan', self.convert_range, qos_profile_sensor_data
+                )
+            )
+        aliases = [
+            (Image, 'head_front_camera/image', 'head_front_camera/rgb/image_raw'),
+            (Image, 'head_front_camera/depth_image', 'head_front_camera/depth/image_raw'),
+            (
+                Image,
+                'head_front_camera/depth_image',
+                'head_front_camera/depth_registered/image_raw',
+            ),
+            (CameraInfo, 'head_front_camera/camera_info', 'head_front_camera/rgb/camera_info'),
+            (CameraInfo, 'head_front_camera/camera_info', 'head_front_camera/depth/camera_info'),
+            (
+                CameraInfo,
+                'head_front_camera/camera_info',
+                'head_front_camera/depth_registered/camera_info',
+            ),
+            (PointCloud2, 'head_front_camera/points', 'head_front_camera/depth_registered/points'),
+            (PointCloud2, 'head_front_camera/points', 'head_front_camera/depth/rgb/points'),
+        ]
+        for message_type, source, target in aliases:
+            publisher = self.create_publisher(message_type, target, qos_profile_sensor_data)
+            self.relays.append(
+                self.create_subscription(
+                    message_type, source, publisher.publish, qos_profile_sensor_data
+                )
+            )
+        if self.get_parameter('base_type').value == 'omni_base':
+            self.tf = Buffer()
+            self.listener = TransformListener(self.tf, self)
+            self.scans = {}
+            self.scan = self.create_publisher(LaserScan, 'scan_raw', qos_profile_sensor_data)
+            for topic in ['scan_front_raw', 'scan_rear_raw']:
+                self.relays.append(
+                    self.create_subscription(
+                        LaserScan,
+                        topic,
+                        lambda msg, key=topic: self.merge_scan(key, msg),
+                        qos_profile_sensor_data,
+                    )
+                )
+
+    def receive_velocity(self, message):
+        self.command = message
+        self.command_time = self.get_clock().now()
+
+    def prepare_sim_description(self, message):
+        # gz_ros2_control implements URDF mimic joints in its write() loop.
+        # Harmonic's default DART backend cannot also create SDF mimic
+        # constraints. Keep the original URDF for controllers, TF and MoveIt;
+        # remove only duplicate physics constraints from the spawn description.
+        self.sim_description.publish(String(data=harmonic_spawn_description(message.data)))
+
+    def convert_range(self, scan):
+        message = Range()
+        message.header = scan.header
+        message.radiation_type = Range.ULTRASOUND
+        message.field_of_view = scan.angle_max - scan.angle_min
+        message.min_range = scan.range_min
+        message.max_range = scan.range_max
+        message.range = min(scan.ranges, default=math.inf)
+        self.sonar.publish(message)
+
+    def publish_velocity(self):
+        now = self.get_clock().now()
+        message = TwistStamped()
+        message.header.stamp = now.to_msg()
+        message.header.frame_id = 'base_footprint'
+        if self.command_time is not None and (now - self.command_time).nanoseconds < 250_000_000:
+            message.twist = self.command
+        self.velocity.publish(message)
+
+    def merge_scan(self, key, message):
+        self.scans[key] = message
+        output = LaserScan()
+        output.header.stamp = message.header.stamp
+        output.header.frame_id = 'base_footprint'
+        output.angle_min = -math.pi
+        output.angle_max = math.pi
+        count = 1081
+        output.angle_increment = 2.0 * math.pi / (count - 1)
+        output.range_min = 0.05
+        output.range_max = 25.0
+        output.scan_time = message.scan_time
+        ranges = [math.inf] * count
+        for scan in self.scans.values():
+            try:
+                transform = self.tf.lookup_transform(
+                    'base_footprint', scan.header.frame_id, rclpy.time.Time()
+                )
+            except TransformException:
+                return
+            q = transform.transform.rotation
+            yaw = math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
+            origin = transform.transform.translation
+            for index, distance in enumerate(scan.ranges):
+                if not math.isfinite(distance) or not scan.range_min <= distance <= scan.range_max:
+                    continue
+                angle = scan.angle_min + index * scan.angle_increment + yaw
+                x = origin.x + distance * math.cos(angle)
+                y = origin.y + distance * math.sin(angle)
+                bin_index = round((math.atan2(y, x) + math.pi) / output.angle_increment)
+                if 0 <= bin_index < count:
+                    ranges[bin_index] = min(ranges[bin_index], math.hypot(x, y))
+        output.ranges = ranges
+        self.scan.publish(output)
+
+
+def main():
+    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
+    # Only set a flag inside the Python signal handler. Shutting down the ROS
+    # context there can re-enter executor locks during a DDS callback.
+    stopping = False
+
+    def request_stop(*_):
+        nonlocal stopping
+        stopping = True
+
+    signal.signal(signal.SIGINT, request_stop)
+    signal.signal(signal.SIGTERM, request_stop)
+    node = SimulationAdapter()
+    try:
+        while rclpy.ok() and not stopping:
+            rclpy.spin_once(node, timeout_sec=0.1)
+    except (KeyboardInterrupt, ExternalShutdownException):
+        pass
+    except RuntimeError:
+        if rclpy.ok():
+            raise
+    finally:
+        node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    main()
