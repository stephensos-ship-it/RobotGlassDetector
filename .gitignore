# Upstream checkouts are reconstructed from the pinned manifest and patch bundle.
# The team's own packages (contention_*) live beside them and are tracked.
/tiago_jazzy_ws/src/*
!/tiago_jazzy_ws/src/contention_*/

# Native build products and local verification output.
/tiago_jazzy_ws/build/
/tiago_jazzy_ws/install/
/tiago_jazzy_ws/log/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
*.pyc
